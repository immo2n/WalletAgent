digraph AgentPackage {
    rankdir=TB;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    subgraph cluster_perception {
        label="Perception Feeds";
        style=dashed;
        color="#2563eb";
        fillcolor="#f8fafc";

        ExchangeService [label="ExchangeService\n- Live ETH Price\n- Gas Feed (gwei)\n- Scenario Emitter", fillcolor="#eff6ff", color="#3b82f6"];
        UserDB [label="UserDatabase\n- USDC & ETH Balances\n- Ledger Audit", fillcolor="#eff6ff", color="#3b82f6"];
    }

    subgraph cluster_agent {
        label="Autonomous Agent Package (agent/)";
        style=dashed;
        color="#7e22ce";
        fillcolor="#f8fafc";

        TaskManager [label="TaskManager (agent/task.py)\n- Max Tasks = 1\n- User Deletion\n- Task States (ACTIVE, EXECUTED, CANCELLED)", fillcolor="#faf5ff", color="#a855f7"];
        AgentRuntime [label="AutonomousAgent Daemon (agent/runtime.py)\n- Always Running Thread\n- State Machine: IDLE, MONITORING, TRIGGER, EXECUTING\n- Thought Trace Stream", fillcolor="#f3e8ff", color="#9333ea"];
        GuardCheck [label="Z3 Invariant Gate\n- balance - trade >= floor\n- gas <= target", fillcolor="#fef9c3", color="#eab308"];

        TaskManager -> AgentRuntime [label="supplies active task"];
        AgentRuntime -> GuardCheck [label="verifies invariants"];
    }

    subgraph cluster_actions {
        label="Guarded Actions & Evidence";
        style=dashed;
        color="#16a34a";
        fillcolor="#f8fafc";

        ExecuteSwap [label="Execute Swap\n- Update User DB Balances\n- Record AGENT Transaction", fillcolor="#dcfce7", color="#16a34a"];
        BlockAction [label="Block Action\n- Record BLOCKED_BY_GUARD\n- Log Reason", fillcolor="#fee2e2", color="#dc2626"];
    }

    ExchangeService -> AgentRuntime [label="real-time ticks"];
    UserDB -> AgentRuntime [label="current balances"];
    GuardCheck -> ExecuteSwap [label="if passed"];
    GuardCheck -> BlockAction [label="if breached"];
    ExecuteSwap -> UserDB [label="persists balance change"];
    ExecuteSwap -> TaskManager [label="marks task EXECUTED"];
}
