// Graphviz DOT Flowchart for Verified-Policy Wallet Agent: Policy Package
// Render with: dot -Tsvg visuals/policy.dot -o visuals/policy.svg
// Or view in any Graphviz previewer (VS Code Graphviz extension, edotor.net)

digraph PolicyVerificationFlow {
    rankdir=TB;
    compound=true;
    newrank=true;
    bgcolor="#0d1117";
    fontname="Inter, Helvetica, Arial, sans-serif";
    fontsize=13;
    fontcolor="#c9d1d9";

    node [
        fontname="Inter, Helvetica, Arial, sans-serif",
        fontsize=11,
        fontcolor="#f0f6fc",
        shape=box,
        style="filled,rounded",
        color="#30363d",
        fillcolor="#161b22",
        penwidth=1.5
    ];

    edge [
        fontname="Inter, Helvetica, Arial, sans-serif",
        fontsize=10,
        fontcolor="#8b949e",
        color="#58a6ff",
        arrowsize=0.8,
        penwidth=1.4
    ];

    // Inputs
    subgraph cluster_input {
        label="1. User Natural Language Intent";
        fontcolor="#58a6ff";
        style="dashed,rounded";
        color="#388bfd";
        fillcolor="#161b22";

        user_prompt [
            label="User Prompt\n(e.g., 'Buy if gas under 5% and do not go under $500 balance')",
            shape=ellipse,
            fillcolor="#1f2937",
            color="#58a6ff"
        ];
    }

    // Dual Readers Subgraph
    subgraph cluster_readers {
        label="2. Dual Independent Formalization (Untrusted Proposer)";
        fontcolor="#7ee787";
        style="dashed,rounded";
        color="#238636";
        fillcolor="#0e1712";

        reader_a [
            label="Reader A (Deterministic)\n• spaCy Dependency Parser\n• Typed Lexicon & Phrase Mappings\n(readers/rule_reader.py)",
            fillcolor="#1a2e1d",
            color="#3fb950"
        ];

        reader_b [
            label="Reader B (Untrusted LLM)\n• Strict Draft-07 JSON Schema\n• Raw AST Generation\n(readers/llm_reader.py)",
            fillcolor="#2e1a1a",
            color="#f85149"
        ];

        tier2_check [
            label="Reader A Unreadable?",
            shape=diamond,
            fillcolor="#21262d",
            color="#d29922"
        ];

        tier2_llm [
            label="Tier 2 LLM Fallback Reader\n(Independence: 'llm-llm')",
            fillcolor="#2e2212",
            color="#d29922"
        ];
    }

    // Typechecker & Coercions Subgraph
    subgraph cluster_typecheck {
        label="3. Static Typechecker & Ambiguity Resolution";
        fontcolor="#e3b341";
        style="dashed,rounded";
        color="#bb8009";
        fillcolor="#16140c";

        ast_union [
            label="Union ASTs by Stable Key\n(e.g., 'gas:lt:1/20')",
            fillcolor="#21262d"
        ];

        type_check [
            label="Typechecker (typecheck.py)\n• SORT_MISMATCH (GWEI vs RATIO)\n• ASSUMED_PROVENANCE\n• BAD_BOUND",
            fillcolor="#21262d"
        ];

        ambiguity_modal [
            label="User Clarification Modal\n(Search Coercion Table in coercions.py)\n[1] pct_below_avg24h\n[2] pct_above_avg24h\n[3] lowest_pctile24h\n[4] absolute_reinterpret",
            shape=invtrapezium,
            fillcolor="#38280f",
            color="#f0883e"
        ];

        resolve_ast [
            label="resolve() Engine\nRewrites AST terms with\nprovenance = 'confirmed'",
            fillcolor="#1a2e1d",
            color="#3fb950"
        ];

        provenance_gate [
            label="Any Unconfirmed\n'assumed' Provenance?",
            shape=diamond,
            fillcolor="#2e1a1a",
            color="#f85149"
        ];
    }

    // Z3 Equivalence Subgraph
    subgraph cluster_z3 {
        label="4. Z3 Formal Verification (compare.py & z3_compile.py)";
        fontcolor="#bc8cff";
        style="dashed,rounded";
        color="#8957e5";
        fillcolor="#140f1f";

        z3_compile [
            label="Z3 Compiler (z3_compile.py)\nAST -> Named BoolRef Expressions\nExact RealVal & DOMAIN Bounds",
            fillcolor="#231936",
            color="#a371f7"
        ];

        z3_compare [
            label="Two-Direction Equivalence Proof\nCheck 1: A ∧ ¬B (B is stricter)\nCheck 2: B ∧ ¬A (B is looser)\nTimeout: 5.0 seconds",
            shape=diamond,
            fillcolor="#231936",
            color="#bc8cff"
        ];

        counterexample [
            label="Counterexample Extraction\nConcrete Real States\n(e.g., balance=500, trade=1)",
            fillcolor="#361717",
            color="#f85149"
        ];

        retry_check [
            label="Repair Attempts <= 2?",
            shape=diamond,
            fillcolor="#21262d",
            color="#d29922"
        ];

        repair_prompt [
            label="Render Concrete Feedback\nFeed verbatim numbers to Reader B",
            fillcolor="#21262d",
            color="#58a6ff"
        ];
    }

    // Sanity Subgraph
    subgraph cluster_sanity {
        label="5. Sanity Checks (sanity.py)";
        fontcolor="#39c5cf";
        style="dashed,rounded";
        color="#1f6feb";
        fillcolor="#0d1724";

        sanity_check [
            label="Solver Sanity\n1. Satisfiable (A ∧ DOMAIN ≠ ∅)\n2. Non-vacuous (¬A is satisfiable)\n3. Non-redundant",
            shape=diamond,
            fillcolor="#102538",
            color="#388bfd"
        ];
    }

    // Outputs
    subgraph cluster_output {
        label="6. Verified Artifacts";
        fontcolor="#7ee787";
        style="dashed,rounded";
        color="#238636";
        fillcolor="#0e1712";

        verified_policy [
            label="VerifiedPolicy Object\n(Status: VERIFIED)\nAttempts, Independence mode",
            shape=box3d,
            fillcolor="#132b17",
            color="#3fb950"
        ];

        readback [
            label="Controlled English Readback\n(Plain English user confirmation)",
            fillcolor="#161b22"
        ];

        sha256_hash [
            label="Canonical SHA-256 Policy Hash\n(Immutable commitment across paraphrases)",
            fillcolor="#161b22"
        ];

        onchain_params [
            label="On-chain Parameters Export\n(minBalanceAfterUsd, perTxCapUsd,\nallowTokens, policyHash)",
            fillcolor="#161b22"
        ];

        guard_handoff [
            label="To Deterministic Guard Layer\n(guard/ & contracts/)",
            shape=ellipse,
            fillcolor="#1f2937",
            color="#58a6ff"
        ];
    }

    // Terminal Failures
    rejected [
        label="REJECTED\n(Unreadable, Ambiguity Refusal,\nVacuous/Contradictory)",
        shape=octagon,
        fillcolor="#3c1414",
        color="#f85149"
    ];

    human_review [
        label="NEEDS_HUMAN_REVIEW\n(Exceeded 2 LLM repair attempts)",
        shape=octagon,
        fillcolor="#3c2614",
        color="#d29922"
    ];

    // Edges
    user_prompt -> reader_a;
    user_prompt -> reader_b;

    reader_a -> tier2_check;
    tier2_check -> reader_b [label="Primary OK", color="#3fb950"];
    tier2_check -> tier2_llm [label="Unreadable\n(Tier 2)", color="#d29922"];
    tier2_check -> rejected [label="Garbage / Refusal", color="#f85149"];
    tier2_llm -> ast_union [color="#d29922"];

    reader_a -> ast_union [color="#3fb950"];
    reader_b -> ast_union [color="#f85149"];

    ast_union -> type_check;
    type_check -> ambiguity_modal [label="SORT_MISMATCH", color="#f0883e"];
    type_check -> provenance_gate [label="Clean Types", color="#3fb950"];

    ambiguity_modal -> resolve_ast [label="User Selects Option", color="#3fb950"];
    resolve_ast -> provenance_gate;

    provenance_gate -> rejected [label="Yes (Assumed)", color="#f85149"];
    provenance_gate -> z3_compile [label="No (Confirmed)", color="#3fb950"];

    z3_compile -> z3_compare;

    z3_compare -> sanity_check [label="Equivalent\n(0 Findings)", color="#3fb950"];
    z3_compare -> counterexample [label="Mismatch Found", color="#f85149"];

    counterexample -> retry_check;
    retry_check -> repair_prompt [label="Yes (Attempts <= 2)", color="#58a6ff"];
    retry_check -> human_review [label="No (> 2 retries)", color="#d29922"];

    repair_prompt -> reader_b [label="Retry with Counterexample", color="#58a6ff", style="dashed"];

    sanity_check -> verified_policy [label="All Passed", color="#3fb950"];
    sanity_check -> rejected [label="Failed Sanity", color="#f85149"];

    verified_policy -> readback;
    verified_policy -> sha256_hash;
    verified_policy -> onchain_params;
    onchain_params -> guard_handoff [color="#58a6ff"];
}
