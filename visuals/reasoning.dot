digraph CognitiveReasoningPipeline {
    graph [
        rankdir=LR,
        bgcolor="#ffffff",
        fontname="Helvetica,Arial,sans-serif",
        fontsize=12,
        pad="0.5",
        nodesep="0.6",
        ranksep="0.8"
    ];

    node [
        fontname="Helvetica,Arial,sans-serif",
        fontsize=10,
        shape=box,
        style="rounded,filled",
        fillcolor="#f8fafc",
        color="#cbd5e1",
        penwidth=1.5
    ];

    edge [
        fontname="Helvetica,Arial,sans-serif",
        fontsize=9,
        color="#64748b",
        penwidth=1.2,
        arrowsize=0.8
    ];

    // Data Sources
    subgraph cluster_sources {
        label="Dual Perception Sources";
        style="rounded,dashed";
        color="#94a3b8";
        bgcolor="#f1f5f9";

        LiveMarket [
            label="Live Market Feeds\n(Coinbase WS: ETH Price\nTrusted Oracle: Gas Gwei)",
            fillcolor="#eff6ff",
            color="#3b82f6"
        ];

        HistoryDB [
            label="Historical Regimes DB\n(reasoning/data/market_history.json\nWin-Rates, Drawdowns, Regimes)",
            fillcolor="#faf5ff",
            color="#a855f7"
        ];
    }

    // Cognitive Pipeline
    subgraph cluster_pipeline {
        label="Fragmented Cognitive Reasoning Engine";
        style="rounded";
        color="#3b82f6";
        bgcolor="#ffffff";

        RAGRetriever [
            label="Stage 1: RAG Context Retrieval\nMatch Current Gas & Price to Regime\nCalculate Similarity & Win-Rate",
            fillcolor="#ecfdf5",
            color="#10b981"
        ];

        Chunk1_Intent [
            label="Stage 2: Fragmented LLM Chunk 1\nStrategy Intent & Thesis Formulation\nEvaluate Historical Profitability",
            fillcolor="#f0fdf4",
            color="#22c55e"
        ];

        RiskSimulator [
            label="Stage 3: Dry-Run Risk Simulation\nSimulate Slippage, 24h Delta,\nMax Drawdown, Risk Score (1-10)",
            fillcolor="#fffbeb",
            color="#f59e0b"
        ];

        Chunk2_RiskEval [
            label="Stage 3b: Fragmented LLM Chunk 2\nClearance Decision\n(PROCEED vs ABORT_HIGH_RISK)",
            fillcolor="#fef3c7",
            color="#d97706"
        ];
    }

    // Formal Verification & Execution
    subgraph cluster_gates {
        label="Fail-Closed Formal Gates";
        style="rounded";
        color="#ef4444";
        bgcolor="#ffffff";

        Z3Gate [
            label="Stage 4: Programmatic Z3 Gates\nInvariant: balance - trade >= 500\nTrigger: gas <= 20 gwei\nSolver: SAT / UNSAT",
            fillcolor="#fef2f2",
            color="#ef4444",
            penwidth=2.0
        ];

        TxLedger [
            label="Live Transaction Ledger\nConfirmed On-Chain Swap (Base Sepolia)\nAttached Full Reasoning Report\nDedicated [Reasoning] Modal Button",
            fillcolor="#f8fafc",
            color="#0f172a",
            penwidth=2.0
        ];
    }

    // Connections
    LiveMarket -> RAGRetriever [label="Live Gas & Price"];
    HistoryDB -> RAGRetriever [label="Indexed Historical Regimes"];

    RAGRetriever -> Chunk1_Intent [label="Top Matched Regime\n+ Live Context"];
    Chunk1_Intent -> RiskSimulator [label="Proposed Swap Intent\n($200 USDC -> ETH)"];

    LiveMarket -> RiskSimulator [label="Current Price & Gas"];
    RiskSimulator -> Chunk2_RiskEval [label="Simulated Outcome &\nRisk Metrics"];

    Chunk2_RiskEval -> Z3Gate [label="Risk Clearance Passed\n(Proceed to Gates)"];
    Z3Gate -> TxLedger [label="Z3 Proof SAT\nExecute Swap & Store Audit"];

    Chunk2_RiskEval -> TxLedger [label="Risk Abort (Log Audit)", style=dashed, color="#f59e0b"];
    Z3Gate -> TxLedger [label="Guard Block (Log Audit)", style=dashed, color="#ef4444"];
}
