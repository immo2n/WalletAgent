flowchart TD
    K["Daemon tick"]
    Q["Active task and schedule"]
    M["Market state<br/>price • gas • scenario"]
    G{"Trigger satisfied?"}
    R["RAG regime retrieval"]
    I["Intent and trade thesis"]
    D["Dry-run simulation<br/>slippage • balance • risk"]
    Z{"Deterministic gates pass?"}
    E["EVM-style preflight<br/>custom-error decoding"]
    X["Persist local result<br/>ledger • reasoning • task"]
    H["Block and audit reason"]

    K --> Q --> M --> G
    G -->|no| K
    G -->|yes| R --> I --> D --> Z
    Z -->|no| H --> K
    Z -->|yes| E --> X --> K
