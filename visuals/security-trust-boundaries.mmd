---
config:
  theme: base
  themeVariables:
    primaryColor: "#e8f1ff"
    primaryTextColor: "#10233f"
    primaryBorderColor: "#2f6fed"
    lineColor: "#53657d"
    secondaryColor: "#fff4df"
    tertiaryColor: "#eef8f1"
---
flowchart LR
    human["Human owner / reviewer"]
    browser["Browser dashboard<br/>Flask API"]
    workflow["Policy workflow<br/>DRAFT → REVIEWED → DEPLOYABLE → ACTIVE"]
    agent["Autonomous agent<br/>task registry + runtime"]
    guards["Deterministic gates<br/>typecheck • Z3 • simulator"]
    client["PolicyWalletClient<br/>local synchronized state"]
    contract["PolicyWallet.sol<br/>owner/operator guards"]
    rpc["Base Sepolia RPC<br/>(optional eth_call)"]
    router["External router call<br/>router.call(routerData)"]
    state[("JSON state<br/>wallet + tasks")]
    llm["Mock/Groq reader<br/>untrusted interpretation"]
    market["Market/WebSocket + gas oracle"]

    human -->|"review / approve / pause"| browser
    browser --> workflow
    browser -->|"unauthenticated HTTP routes"| agent
    browser --> guards
    llm -->|"candidate policy"| guards
    market --> guards
    guards --> workflow
    workflow --> agent
    agent --> client
    agent --> state
    client -.->|"simulation / generated tx identifier"| contract
    client --> rpc
    contract --> router
    browser --> state

    classDef trust fill:#eef8f1,stroke:#1f8a4c,stroke-width:1.5px;
    classDef boundary fill:#fff4df,stroke:#cc8a00,stroke-width:1.5px;
    classDef risk fill:#ffe9e9,stroke:#c93636,stroke-width:1.5px;
    class human,workflow,guards,contract trust;
    class browser,agent,client,state boundary;
    class llm,router,rpc,market risk;
