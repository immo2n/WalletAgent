# ==============================================================================
# Verified-Policy Wallet Agent — Environment Configuration Template
# Copy this file to .env and fill in your secrets and endpoints.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration (Used in policy discovery and agent reasoning)
# ------------------------------------------------------------------------------
# Implemented providers: "mock" and "groq".
# Use "mock" for the offline local fallback.
LLM_PROVIDER=mock

# Primary API Key (can be used generically by EnvLLMClient)
LLM_API_KEY=your_primary_api_key_here

# Provider-specific API key (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Model selection is unused by the offline mock provider.
LLM_MODEL=mock

# Optional Groq-compatible endpoint, only when LLM_PROVIDER=groq.
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# ------------------------------------------------------------------------------
# 2. Reference blockchain and contract settings
# These values document the intended Base Sepolia deployment, but are not
# currently read by the local Flask simulation.
# ------------------------------------------------------------------------------
# Target network (Base Sepolia is standard for FinTechathon Topic F)
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
EXPLORER_URL=https://sepolia.basescan.org

# Wallet Keys (NEVER commit real private keys with mainnet funds!)
# Agent Key (untrusted execution key held by the autonomous bot)
AGENT_PRIVATE_KEY=0x_your_agent_bot_private_key_here

# Owner Address (human owner key authorized for policy updates & pause/unpause)
OWNER_ADDRESS=0x_your_human_owner_public_address_here

# Deployed Smart Contract Address (populated after deploying contracts/)
WALLET_CONTRACT_ADDRESS=0x_your_deployed_wallet_contract_address_here

# ------------------------------------------------------------------------------
# 3. Reference market-data settings
# These values are reserved for future integrations and are not currently read
# by the local Flask simulation.
# ------------------------------------------------------------------------------
# Gas tracker and price oracles
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=

# ------------------------------------------------------------------------------
# 4. Reference guard and verification settings
# Z3 and repair settings currently use code defaults.
# ------------------------------------------------------------------------------
Z3_TIMEOUT_MS=5000
MAX_POLICY_REPAIRS=2
